# =========================
# Terraform
# =========================

# Local .terraform directories
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Terraform variable files (often contain secrets)
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform plan files
*.tfplan
plan.out

# Terraform CLI config files
.terraformrc
terraform.rc

# Terraform lock file (uncomment if you don't want to commit it)
# .terraform.lock.hcl

# =========================
# Docker
# =========================

# Environment files
.env
.env.*

# Docker Compose override files
docker-compose.override.yml

# Logs
*.log

# Temporary files
tmp/
temp/

# IDE / OS files
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db